# Environment files with secrets
.env
.env.local
.env.*.local

# Generated configs with sensitive data
configs/
!configs/.gitkeep

# WireGuard / SSH keys
*.key
*.pub
*.pem
# Stray / extensionless OpenSSH private keys (e.g. test keypair "8")
8
id_rsa
id_ed25519
id_ecdsa

# Terraform state (if using terraform)
*.tfstate
*.tfstate.*
.terraform/

# OS files
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# Logs
*.log

# Python build/test artifacts
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.coverage
*.egg-info/

# --- Sensitive data: NEVER publish ---
# Session summaries / agent handoffs — contain live VM facts (public IPs, OCIDs, key paths)
.summary/
*HANDOFF*
*handoff*
*CONNECTION-DETAILS*
*connection-details*
# Credentials / secrets files
*-credentials
*.credentials
credentials.json
credentials.yaml
*.secret
*.secrets
# Cloud topology / inventory with real identities
deployment-info*
hosts.ini
ansible_vars.json
oci-config
.oci/
# VPN client configs (embed private keys)
client_*.conf
wg-*.conf
wg0.conf
*.ovpn
