# OCI Remote Development VM Configuration
# Copy this file to .env and customize for your local deployment.
# .env is git-ignored and may contain environment-specific topology.
# ============================================================

# ================== OCI CONFIGURATION ==================
# OCI CLI profile name from ~/.oci/config (leave empty for DEFAULT)
OCI_PROFILE=""

# Tenancy OCID (auto-detected from profile if empty)
OCI_TENANCY_OCID=""

# Compartment name or OCID where VM will be created.
# Leave empty to use the tenancy root compartment when OCI_COMPARTMENT_OCID is not set.
OCI_COMPARTMENT_NAME=""
OCI_COMPARTMENT_OCID=""

# Region (auto-detected from profile if empty)
OCI_REGION=""

# ================== VM CONFIGURATION ==================
# Instance name
VM_NAME="remote-dev-server"

# VM Shape (AMD EPYC shapes: VM.Standard.E4.Flex, VM.Standard.E5.Flex, VM.Standard.E6.Flex)
VM_SHAPE="VM.Standard.E6.Flex"

# VM Resources
VM_OCPUS=4
VM_MEMORY_GB=32

# Boot Volume Size (GB) - minimum 50GB for Ubuntu with desktop
VM_BOOT_VOLUME_GB=100

# Ubuntu Version (22.04 or 24.04)
UBUNTU_VERSION="24.04"

# Availability Domain (1, 2, or 3 - or leave empty for auto)
AVAILABILITY_DOMAIN=""

# ================== NETWORK CONFIGURATION ==================
# Option 1: Use existing VCN and Subnet (leave empty to create new)
# If both are provided, they will be used directly (skipping VCN/Subnet creation)
EXISTING_VCN_OCID=""
EXISTING_SUBNET_OCID=""

# Option 2: Create new VCN/Subnet with these settings (ignored if existing OCIDs provided)
# VCN Name (will create new if doesn't exist)
VCN_NAME="remote-dev-vcn"

# VCN CIDR Block
VCN_CIDR="10.0.0.0/16"

# Subnet CIDR Block
SUBNET_CIDR="10.0.1.0/24"

# ================== SSH CONFIGURATION ==================
# Path to SSH public key for instance access
SSH_PUBLIC_KEY_PATH="~/.ssh/id_rsa.pub"

# ================== WIREGUARD VPN CONFIGURATION ==================
# WireGuard Listen Port
WG_PORT=51820

# WireGuard VPN Network
WG_NETWORK="10.200.200.0/24"

# Server IP within WireGuard network
WG_SERVER_IP="10.200.200.1"

# Client IP (your phone/laptop)
WG_CLIENT_IP="10.200.200.2"

# Routing mode for generated client configs:
#   false (default) = SPLIT TUNNEL. Only WG_NETWORK is routed through the tunnel;
#                     your laptop keeps its own internet path and DNS untouched.
#   true            = FULL TUNNEL. All client traffic (0.0.0.0/0, ::/0) is routed
#                     through the VM. Heavier, and the VM becomes a single point of
#                     failure for your whole connection.
WG_FULL_TUNNEL=false

# Optional DNS server to push to clients. LEAVE EMPTY for split tunnel.
# A DNS line in a split-tunnel config hijacks macOS system resolvers and breaks
# name resolution once the tunnel is up. Only set this with WG_FULL_TUNNEL=true.
WG_DNS=""

# ================== DESKTOP CONFIGURATION ==================
# Desktop Environment: xfce (lightweight), gnome (full-featured), kde
DESKTOP_ENV="xfce"

# Remote Desktop Port (RDP via xrdp)
RDP_PORT=3389

# VNC Port (optional)
VNC_PORT=5901

# ================== DEVELOPMENT TOOLS ==================
# Install Claude Code CLI
INSTALL_CLAUDE_CODE=true

# Install Codex CLI (OpenAI)
INSTALL_CODEX=true

# Install Gemini CLI (Google)
INSTALL_GEMINI=true

# Install VS Code Server (code-server for browser access)
INSTALL_CODE_SERVER=true
CODE_SERVER_PORT=8443

# Install Cursor AppImage
INSTALL_CURSOR=true

# Install local container tooling on the VM:
# Podman, podman-docker compatibility, Buildah, Skopeo, and rootless helpers.
INSTALL_PODMAN=true

# Install cloud provider CLIs on the VM for parallel development and validation.
INSTALL_CSP_CLIS=true
INSTALL_OCI_CLI=true
INSTALL_AWS_CLI=true
INSTALL_GCP_CLI=true
INSTALL_AZURE_CLI=true

# Install the shared MultiLLM gateway + per-user usage collectors as system
# services (VPN-reachable). Aggregates each developer's own Claude/Codex/Gemini
# token usage and cost into a single team view:
#   http://WG_SERVER_IP:MULTILLM_GATEWAY_PORT/team       (multi-user usage)
#   http://WG_SERVER_IP:MULTILLM_GATEWAY_PORT/dashboard  (full gateway)
INSTALL_MULTILLM_GATEWAY=true
MULTILLM_GATEWAY_PORT=8080

# Install the disconnect-resilience layer: durable agent sessions (agentctl),
# mosh, loginctl linger, tmux config, sshd keepalive, and the memory-palace CLI.
INSTALL_RESILIENCE_LAYER=true

# Install Agent-OS: tool guardrails (PreToolUse hook), MCP tool registry, and the
# OCI read-only MCP server.
INSTALL_AGENT_OS=true

# How often each per-user collector reports local usage (minutes).
MULTILLM_COLLECT_INTERVAL_MIN=15

# Optional per-user daily cost caps (USD) → surfaced as an over_budget flag on
# the team dashboard. Format: "user=usd,user=usd".
MULTILLM_USER_BUDGETS=""

# Where the gateway is pip-installed from. Default: the source synced to
# /opt/multillm during deploy. Override with a PyPI spec or git URL.
MULTILLM_INSTALL_SOURCE="/opt/multillm"

# Local source copied to /opt/multillm by Ansible. Keep this as a variable so
# personal filesystem paths never appear in committed Ansible code.
MULTILLM_SOURCE_PATH="../multillm"

# Node.js version (for development tools)
NODE_VERSION="20"

# Python version
PYTHON_VERSION="3.12"

# ================== SECURITY CONFIGURATION ==================
# Create non-root admin user
ADMIN_USERNAME="devuser"

# Enable automatic security updates
AUTO_SECURITY_UPDATES=true

# Firewall strict mode (only allow WireGuard initially)
FIREWALL_STRICT=true

# ================== OPTIONAL: API KEYS ==================
# These can be set after deployment or provided here
# WARNING: Never commit .env.local with real keys!

# Anthropic API Key (for Claude Code)
ANTHROPIC_API_KEY=""

# OpenAI API Key (for Codex)
OPENAI_API_KEY=""

# Google AI API Key (for Gemini CLI)
GOOGLE_AI_API_KEY=""

# GitHub Personal Access Token (for git operations)
GITHUB_TOKEN=""

# ================== MULTIPLE DEVELOPER CONFIGURATION ==================
# Enable multiple developer support. Define DEV_N_* entries for each additional
# developer; N can continue beyond the examples below.
MULTI_DEV_ENABLED=false

# Developer 1 Configuration (Admin user)
# - Username is ADMIN_USERNAME above
# - SSH key path is SSH_PUBLIC_KEY_PATH above
# - VPN IP address is WG_CLIENT_IP above
# - code-server port is CODE_SERVER_PORT above
# Per-account GitHub identity (each UNIX user commits/pushes as itself, even in
# shared /opt/shared-dev repos). Email defaults to <user>@users.noreply.github.com.
GITHUB_USER=""   # admin's GitHub username (defaults to ADMIN_USERNAME)
GIT_NAME=""      # commit author name (defaults to GITHUB_USER)
GIT_EMAIL=""     # commit email (defaults to <GITHUB_USER>@users.noreply.github.com)

# Developer 2 Configuration (Optional)
DEV_2_NAME="alice"
DEV_2_SSH_KEY_PATH=""  # Path to SSH public key (e.g. ~/.ssh/id_alice.pub) or raw ssh-rsa public key string
DEV_2_WG_IP="10.200.200.3"
DEV_2_CODE_SERVER_PORT=8444
DEV_2_GITHUB_USER=""   # alice's GitHub username (defaults to DEV_2_NAME)
DEV_2_GIT_NAME=""      # defaults to DEV_2_GITHUB_USER
DEV_2_GIT_EMAIL=""     # defaults to <DEV_2_GITHUB_USER>@users.noreply.github.com

# Developer 3 Configuration (Optional)
DEV_3_NAME="bob"
DEV_3_SSH_KEY_PATH=""  # Path to SSH public key (e.g. ~/.ssh/id_bob.pub) or raw ssh-rsa public key string
DEV_3_WG_IP="10.200.200.4"
DEV_3_CODE_SERVER_PORT=8445

# ================== PAI / OBI INTEGRATION (Phase 6) ==================
# Deploy PAI (the Algorithm + skills + MEMORY + the Obi DA) per-user on the fleet
# and sync the same knowledge across your own devices. See docs/PAI-INTEGRATION.md.
# Off by default — opt in here.
INSTALL_PAI=false

# Shareable PAI repo (skills / Algorithm / hooks). Cloned into ~/.claude/PAI (0700).
PAI_REPO=""

# PRIVATE encrypted-MEMORY repo (TELOS / health / finances / identity). Holds only
# age-ciphertext. Leave empty to keep MEMORY device-local. See docs/MULTI-DEVICE-SYNC.md.
PAI_MEMORY_REPO=""

# Pull + decrypt the private MEMORY repo on bootstrap.
PAI_SYNC_ENABLED=false

# age PUBLIC keys (age1...) that can decrypt MEMORY — one per device, comma-separated.
# pai-sync REFUSES to run with this empty (never falls back to plaintext).
PAI_AGE_RECIPIENTS=""

# Install `age` and encrypt personal MEMORY at rest on the VM (recommended true).
PAI_ENCRYPT_MEMORY=true

# Agent runtimes to register in the pluggable registry (agent-os/runtimes.json).
PAI_RUNTIMES="claude,codex,gemini,antigravity,hermes,nanoclaw"

# Install the Antigravity (AGY) CLI — Google's terminal coding agent, the
# Google-family runtime that REPLACES the Gemini CLI. Binary: agy. Headless: agy -p "…".
INSTALL_ANTIGRAVITY=true

# Install the Pi coding agent (earendil-works) — self-extensible TS agent,
# multi-provider via pi-ai. Binary: pi. Headless: pi -p "…". Needs Node>=22.19
# (the Pi task upgrades the VM's Node 20 → 22). Runs inside the fleet guardrail
# sandbox (Pi ships no sandboxing of its own). See docs/PI-INTEGRATION.md.
INSTALL_PI=false
